.editor-page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 8%, rgba(226, 96, 59, 0.07), transparent 28%),
    var(--bg);
}

/* 页头 */
.editor-head {
  padding: 28rpx 36rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.editor-eyebrow {
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.editor-title {
  margin-top: 12rpx;
  color: var(--ink);
  font-family: "STSong", "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.editor-sub {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.form-wrap {
  padding: 0 28rpx;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx 32rpx;
}

.form-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2e8da;
}

.heading-left {
  display: flex;
  align-items: center;
}

.heading-index {
  margin-right: 12rpx;
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.heading-title {
  color: var(--ink);
  font-family: "STSong", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.heading-note {
  color: #b1a492;
  font-size: 20rpx;
}

/* 图片 */
.image-card {
  padding: 18rpx;
}

.image-preview {
  position: relative;
  width: 100%;
  height: 390rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #efe6d7;
}

.image {
  display: block;
  width: 100%;
  height: 100%;
}

.image-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(37, 32, 26, 0.65);
  color: #fff8ee;
  font-size: 19rpx;
  backdrop-filter: blur(6rpx);
}

.image-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(37, 32, 26, 0.62);
  color: #fff;
  font-size: 34rpx;
  line-height: 50rpx;
  text-align: center;
  backdrop-filter: blur(6rpx);
}

.image-picker {
  height: 320rpx;
  border: 1rpx dashed #d9c9b3;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(244, 226, 203, 0.5), transparent 56%),
    #fdf9f2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.camera-circle {
  width: 98rpx;
  height: 98rpx;
  border-radius: 30rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-symbol {
  font-size: 43rpx;
}

.picker-title {
  margin-top: 20rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.picker-desc {
  margin-top: 7rpx;
  color: #ab9e8c;
  font-size: 21rpx;
}

.image-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 18rpx 6rpx 2rpx;
}

.image-action {
  padding: 9rpx 20rpx;
  border: 1rpx solid #e7dac8;
  border-radius: 12rpx;
  color: #796b5a;
  font-size: 21rpx;
}

.image-action-danger {
  border-color: #f0d1ca;
  color: var(--danger);
}

/* 字段 */
.field {
  margin-top: 26rpx;
}

.field:first-of-type {
  margin-top: 0;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.required {
  color: var(--brand);
}

.field-count {
  color: #b8ac9b;
  font-size: 19rpx;
}

.field-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ecdfcd;
  border-radius: 16rpx;
  background: #fdf9f2;
  color: var(--ink);
  font-size: 27rpx;
}

.field-input-strong {
  height: 92rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.field-placeholder {
  color: #b9ad9c;
  font-weight: 400;
}

.field-textarea {
  width: 100%;
  min-height: 142rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #ecdfcd;
  border-radius: 16rpx;
  background: #fdf9f2;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.65;
}

.field-row {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.input-with-unit {
  display: flex;
  align-items: center;
  height: 82rpx;
  padding-right: 18rpx;
  border: 1rpx solid #ecdfcd;
  border-radius: 16rpx;
  background: #fdf9f2;
}

.input-with-unit .field-input {
  flex: 1;
  height: 80rpx;
  border: 0;
  background: transparent;
}

.unit {
  flex: none;
  color: #a89b89;
  font-size: 22rpx;
}

.picker-value {
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #ecdfcd;
  border-radius: 16rpx;
  background: #fdf9f2;
  color: var(--ink);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #a99c8a;
  font-size: 26rpx;
}

/* 分类 */
.category-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.category-chip {
  padding: 10rpx 20rpx;
  border: 1rpx solid #e8dbc9;
  border-radius: 14rpx;
  background: #fdf9f2;
  color: #847665;
  font-size: 22rpx;
  line-height: 1.3;
}

.category-chip.active {
  border-color: rgba(226, 96, 59, 0.4);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 600;
}

.category-input {
  height: 74rpx;
  font-size: 24rpx;
}

/* 语音提示 */
.voice-tip {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f6efe4;
  color: #938572;
  font-size: 20rpx;
  line-height: 1.55;
}

.voice-tip-icon {
  flex: none;
  margin-right: 10rpx;
  font-size: 24rpx;
  line-height: 1.3;
}

/* 原材料 */
.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ingredient-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 8rpx 10rpx 8rpx 0;
  border-bottom: 1rpx dashed #f0e4d3;
}

.row-index {
  flex: none;
  width: 42rpx;
  color: #b1a391;
  font-size: 21rpx;
  text-align: center;
}

.ingredient-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  padding: 0 8rpx;
  color: var(--ink);
  font-size: 26rpx;
}

.voice-btn {
  flex: none;
  display: flex;
  align-items: center;
  height: 54rpx;
  margin-left: 8rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e6d9c6;
  border-radius: 999rpx;
  background: #fdf9f2;
  color: #8c7c68;
  font-size: 20rpx;
  white-space: nowrap;
}

.voice-btn.active {
  border-color: rgba(226, 96, 59, 0.4);
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.voice-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.8;
}

.voice-btn.active .voice-dot {
  animation: breathe 0.9s ease-in-out infinite;
}

.row-remove {
  flex: none;
  width: 46rpx;
  height: 54rpx;
  margin-left: 4rpx;
  color: #c2b3a0;
  font-size: 32rpx;
  line-height: 52rpx;
  text-align: center;
}

.add-row {
  height: 82rpx;
  margin-top: 18rpx;
  border: 1rpx dashed #d9c8b1;
  border-radius: 16rpx;
  background: #fdf9f2;
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-plus {
  margin-right: 6rpx;
  font-size: 30rpx;
  font-weight: 400;
}

/* 步骤 */
.step-editor-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-editor {
  padding: 20rpx 18rpx 16rpx;
  border: 1rpx solid #eee1cf;
  border-radius: 20rpx;
  background: #fffaf2;
}

.step-editor-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.step-badge {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: var(--brand);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.step-label {
  margin-left: 12rpx;
  color: #8e806d;
  font-size: 21rpx;
}

.step-tools {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.step-tool {
  min-width: 46rpx;
  height: 42rpx;
  margin-left: 8rpx;
  padding: 0 8rpx;
  border: 1rpx solid #e7dac8;
  border-radius: 9rpx;
  background: #fffdf9;
  color: #7d6f5e;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.step-tool.disabled {
  opacity: 0.3;
}

.step-tool-danger {
  border-color: #efd0c9;
  color: var(--danger);
  font-size: 19rpx;
}

.step-textarea {
  width: 100%;
  min-height: 128rpx;
  padding: 16rpx 14rpx;
  border-radius: 12rpx;
  background: #fffdf9;
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.65;
}

.step-voice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.step-voice-btn {
  height: 52rpx;
}

.step-count {
  color: #c0b3a1;
  font-size: 18rpx;
}

/* 提示 */
.editor-tip {
  padding: 10rpx 12rpx 30rpx;
  color: #a99c8a;
  font-size: 21rpx;
  line-height: 1.65;
  text-align: center;
}

/* 语音悬浮条 */
.voice-hud {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  z-index: 30;
  min-height: 108rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(226, 96, 59, 0.2);
  border-radius: 24rpx;
  background: rgba(48, 42, 35, 0.95);
  box-shadow: 0 18rpx 44rpx rgba(40, 30, 20, 0.24);
  display: flex;
  align-items: center;
  backdrop-filter: blur(14rpx);
}

.voice-pulse {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: rgba(239, 121, 80, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pulse-core {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ef7950;
  animation: breathe 0.9s ease-in-out infinite;
}

.voice-pulse.processing .pulse-core {
  animation-duration: 1.4s;
  background: #e8b07e;
}

.voice-hud-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.voice-hud-title {
  color: #fff8ee;
  font-size: 24rpx;
  font-weight: 600;
}

.voice-hud-text {
  margin-top: 3rpx;
  overflow: hidden;
  color: #b9aa96;
  font-size: 20rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.voice-hud-stop {
  flex: none;
  margin-left: 14rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #ef7950;
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
}

/* 底部保存栏 */
.editor-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(234, 223, 206, 0.85);
  background: rgba(255, 253, 249, 0.95);
  box-shadow: 0 -12rpx 34rpx rgba(92, 70, 39, 0.06);
  display: flex;
  align-items: center;
  backdrop-filter: blur(18rpx);
}

.footer-cancel {
  flex: none;
  width: 170rpx;
  height: 88rpx;
  margin-right: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 44rpx;
  background: #fdf9f2;
  color: #726554;
  font-size: 28rpx;
  line-height: 88rpx;
}

.footer-save {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ef7950, var(--brand-deep));
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-shadow: 0 12rpx 26rpx rgba(226, 96, 59, 0.22);
}

.footer-save[disabled],
.footer-cancel[disabled] {
  opacity: 0.58;
}

/* 加载/错误状态 */
.editor-state {
  margin: 50rpx 30rpx;
  min-height: 380rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #f0dfcb;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-symbol {
  font-size: 76rpx;
  line-height: 1;
}

.state-title {
  margin-top: 22rpx;
  color: var(--ink);
  font-family: "STSong", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.state-desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.state-actions {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-top: 32rpx;
}

.state-button {
  padding: 15rpx 36rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.state-link {
  color: #8f8271;
  font-size: 24rpx;
  text-decoration: underline;
}
