.detail-page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 4% 38%, rgba(226, 96, 59, 0.05), transparent 30%),
    var(--bg);
}

/* 顶部大图 */
.hero-media {
  position: relative;
  width: 100%;
  height: 620rpx;
  overflow: hidden;
  background: #302a23;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 26% 18%, rgba(255, 246, 230, 0.12), transparent 32%),
    linear-gradient(145deg, #3a332a, #221f1a);
}

.empty-plate {
  width: 190rpx;
  height: 190rpx;
  border: 1rpx solid rgba(255, 240, 220, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-emoji {
  font-size: 88rpx;
}

.empty-text {
  margin-top: 26rpx;
  color: #9b8e7c;
  font-size: 23rpx;
  letter-spacing: 2rpx;
}

.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 360rpx;
  background: linear-gradient(to top, rgba(25, 21, 17, 0.9), rgba(25, 21, 17, 0.18), transparent);
  pointer-events: none;
}

.media-top {
  position: absolute;
  top: 28rpx;
  left: 30rpx;
  right: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.media-category {
  max-width: 360rpx;
  padding: 9rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 248, 236, 0.24);
  border-radius: 999rpx;
  background: rgba(35, 30, 24, 0.4);
  color: #fff8ee;
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  backdrop-filter: blur(8rpx);
}

.share-chip {
  display: flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 248, 236, 0.25);
  border-radius: 999rpx;
  background: rgba(35, 30, 24, 0.4);
  color: #fff8ee;
  font-size: 22rpx;
  backdrop-filter: blur(8rpx);
}

.share-chip-hover {
  opacity: 0.72;
}

.share-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.media-caption {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 54rpx;
  display: flex;
  flex-direction: column;
}

.media-kicker {
  color: #d7b9a3;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.media-title {
  margin-top: 10rpx;
  color: #fff9f0;
  font-family: "STSong", "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.24);
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 正文 */
.detail-body {
  position: relative;
  z-index: 2;
  margin-top: -34rpx;
  padding: 0 28rpx;
}

.intro-card {
  padding: 34rpx 30rpx 26rpx;
}

.intro-text {
  display: block;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.intro-empty {
  color: #aa9d8c;
}

.meta-grid {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 24rpx 8rpx;
  border-top: 1rpx solid #f1e7d9;
  border-bottom: 1rpx solid #f1e7d9;
}

.meta-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  color: #b0a392;
  font-size: 20rpx;
}

.meta-value {
  max-width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta-divider {
  flex: none;
  width: 1rpx;
  height: 44rpx;
  background: #eee2d2;
}

.intro-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  color: #b2a594;
  font-size: 21rpx;
}

.copy-tag {
  padding: 3rpx 13rpx;
  border-radius: 8rpx;
  background: #f4ebde;
  color: #927a5e;
  font-size: 19rpx;
}

/* 内容区块 */
.section-card {
  margin-top: 24rpx;
  padding: 34rpx 30rpx 36rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2e8da;
}

.heading-left {
  display: flex;
  align-items: center;
}

.heading-index {
  margin-right: 14rpx;
  color: var(--brand);
  font-family: "Helvetica Neue", sans-serif;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.heading-title {
  color: var(--ink);
  font-family: "STSong", "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.heading-count {
  color: #b0a392;
  font-size: 21rpx;
}

/* 用料 */
.ingredient-list {
  padding-top: 8rpx;
}

.ingredient-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx dashed #f1e6d6;
}

.ingredient-item:last-child {
  border-bottom: 0;
}

.ingredient-mark {
  flex: none;
  width: 13rpx;
  height: 13rpx;
  margin: 14rpx 18rpx 0 2rpx;
  border-radius: 4rpx;
  background: var(--brand);
  transform: rotate(45deg);
}

.ingredient-text {
  flex: 1;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 步骤 */
.step-list {
  padding-top: 28rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
}

.step-number-wrap {
  position: relative;
  flex: none;
  width: 62rpx;
  display: flex;
  justify-content: center;
}

.step-number {
  position: relative;
  z-index: 2;
  width: 46rpx;
  height: 46rpx;
  border-radius: 15rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-family: "Helvetica Neue", sans-serif;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-align: center;
}

.step-line {
  position: absolute;
  top: 52rpx;
  bottom: -10rpx;
  left: 50%;
  width: 1rpx;
  background: #eddfcd;
}

.step-text {
  flex: 1;
  min-width: 0;
  padding: 0 0 40rpx 16rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.section-empty {
  padding: 44rpx 0 18rpx;
  color: #b3a695;
  font-size: 24rpx;
  text-align: center;
}

/* 结尾 */
.detail-end {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 54rpx 0 28rpx;
}

.end-line {
  width: 52rpx;
  height: 1rpx;
  background: #d9cbb8;
}

.end-text {
  margin: 0 18rpx;
  color: #b8ab9a;
  font-size: 21rpx;
  letter-spacing: 3rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(234, 223, 206, 0.8);
  background: rgba(255, 253, 249, 0.94);
  box-shadow: 0 -12rpx 34rpx rgba(92, 70, 39, 0.06);
  backdrop-filter: blur(18rpx);
}

.action-inner {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.action-btn {
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-danger {
  flex: none;
  width: 190rpx;
  border: 1rpx solid #efcbc4;
  background: #fff8f5;
  color: var(--danger);
}

.action-primary {
  flex: 1;
  background: linear-gradient(135deg, #ef7950, var(--brand-deep));
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(226, 96, 59, 0.24);
}

.action-wide {
  width: 100%;
}

.action-btn[disabled] {
  opacity: 0.6;
}

/* 错误与骨架 */
.error-state {
  margin: 80rpx 30rpx;
  padding: 86rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.error-symbol {
  font-size: 82rpx;
}

.error-title {
  margin-top: 24rpx;
  color: var(--ink);
  font-family: "STSong", "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.error-desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.error-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 34rpx;
}

.state-button {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
}

.state-link {
  margin-top: 24rpx;
  color: #8f8271;
  font-size: 24rpx;
  text-decoration: underline;
}

.detail-skeleton {
  padding-bottom: 40rpx;
}

.hero-skeleton {
  width: 100%;
  height: 620rpx;
}

.body-skeleton {
  margin: -30rpx 28rpx 0;
  padding: 46rpx 30rpx;
  border-radius: 28rpx;
  background: #fffdf9;
}

.skeleton-line {
  height: 26rpx;
  margin-bottom: 24rpx;
  border-radius: 13rpx;
}

.skeleton-line.w70 {
  width: 70%;
}

.skeleton-line.w90 {
  width: 90%;
}

.skeleton-line.w50 {
  width: 50%;
}

.shimmer {
  background: linear-gradient(100deg, #f0e7da 20%, #faf5ed 42%, #f0e7da 64%);
  background-size: 220% 100%;
  animation: shimmer 1.5s linear infinite;
}

@keyframes shimmer {
  from {
    background-position: 180% 0;
  }
  to {
    background-position: -40% 0;
  }
}
