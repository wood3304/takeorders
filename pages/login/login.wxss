.login-page {
  position: relative;
  min-height: 100vh;
  padding: 80rpx 44rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 12% 4%, rgba(226, 96, 59, 0.12), transparent 38%),
    radial-gradient(circle at 92% 38%, rgba(95, 125, 98, 0.12), transparent 34%),
    var(--bg);
}

.ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-one {
  top: -160rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  border: 2rpx solid rgba(226, 96, 59, 0.08);
}

.ambient-two {
  bottom: 120rpx;
  left: -220rpx;
  width: 460rpx;
  height: 460rpx;
  background: rgba(255, 255, 255, 0.35);
}

.login-hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 30rpx;
  animation: fade-up 0.55s ease-out both;
}

.logo-wrap {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-ring {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 1rpx solid rgba(226, 96, 59, 0.24);
  border-radius: 50%;
  transform: rotate(-12deg) scaleY(0.62);
}

.logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 42rpx;
  background: linear-gradient(145deg, #f3895e 0%, var(--brand) 58%, #b93e20 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 22rpx 50rpx rgba(201, 73, 39, 0.28);
  transform: rotate(-5deg);
}

.logo-symbol {
  color: #fff9f2;
  font-family: "STSong", "Songti SC", serif;
  font-size: 66rpx;
  font-weight: 700;
  transform: rotate(5deg);
}

.brand-name {
  margin-top: 32rpx;
  color: var(--ink);
  font-family: "STSong", "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.brand-slogan {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 25rpx;
  letter-spacing: 4rpx;
}

.login-panel {
  position: relative;
  z-index: 1;
  margin-top: 72rpx;
  padding: 44rpx 36rpx 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 36rpx;
  background: rgba(255, 253, 249, 0.82);
  box-shadow: 0 30rpx 70rpx rgba(92, 70, 39, 0.1);
  backdrop-filter: blur(16rpx);
  animation: fade-up 0.55s 0.08s ease-out both;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 46rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-icon {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  margin-right: 22rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "STSong", "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.icon-orange {
  color: var(--brand-deep);
  background: var(--brand-soft);
}

.icon-green {
  color: var(--green);
  background: var(--green-soft);
}

.icon-brown {
  color: #86643f;
  background: #f3e9d9;
}

.feature-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.feature-title {
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
}

.feature-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.login-button {
  width: 100%;
}

.login-error {
  display: block;
  margin-top: 20rpx;
  color: var(--danger);
  font-size: 24rpx;
  text-align: center;
}

.privacy-note {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 0 6rpx;
  color: #a89c8c;
  font-size: 21rpx;
  line-height: 1.65;
}

.privacy-dot {
  margin-right: 10rpx;
  color: var(--brand);
  font-size: 30rpx;
  line-height: 1.2;
}

.login-foot {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding-top: 60rpx;
  text-align: center;
  color: #b5a996;
  font-size: 22rpx;
  letter-spacing: 6rpx;
}
